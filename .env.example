# Copier ce fichier en .env et remplir les vraies valeurs.
# .env est dans .gitignore : ne JAMAIS le committer.

# --- Côté client (mobile React Native / Expo) ---
# L'anon key est publique par design (protégée par les RLS policies),
# elle peut être embarquée dans l'app mobile sans risque si les
# policies de 0002_rls_policies.sql sont bien en place.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Côté serveur Node.js UNIQUEMENT ---
# La service_role key contourne TOUTES les policies RLS.
# Elle ne doit JAMAIS être envoyée au client mobile, ni committée,
# ni loguée. Utilisée uniquement pour des tâches admin serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- IA ---
GEMINI_API_KEY=xxxxxxxxxxxx

# --- Serveur ---
PORT=3000
# Liste blanche des origines autorisées (séparées par des virgules)
# Ne jamais mettre "*" même en hackathon si le backend gère la service_role key.
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.10:8081
